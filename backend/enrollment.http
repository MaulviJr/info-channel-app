@courseId = 97196bc7-6217-45f6-ab17-e4ec6b6c0886

### Create enrollment (student)
POST {{baseUrl}}/enrollments
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "courseId": "{{courseId}}"
}

### Update enrollment status (admin)
PATCH {{baseUrl}}/enrollments/{{enrollmentId}}/status
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": "completed"
}

### Change payment status (admin)
PATCH {{baseUrl}}/enrollments/{{enrollmentId}}/payment-status
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": "active"
}

### Get enrollment by id (student/admin/instructor)
# NOTE: This only works if the GET route is wired in backend routes.
GET {{baseUrl}}/enrollments/{{enrollmentId}}
Authorization: Bearer {{accessToken}}

### Delete enrollment (admin)
DELETE {{baseUrl}}/enrollments/{{enrollmentId}}
Authorization: Bearer {{accessToken}}